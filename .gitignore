# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/YazLabUnity/[Ll]ibrary/
/YazLabUnity/[Tt]emp/
/YazLabUnity/[Oo]bj/
/YazLabUnity/[Bb]uild/
/YazLabUnity/[Bb]uilds/
/YazLabUnity/[Ll]ogs/
/YazLabUnity/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/YazLabUnity/[Mm]emoryCaptures/

# Recordings can get excessive in size
/YazLabUnity/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/YazLabUnity/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/YazLabUnity/ServerData
/YazLabUnity/[Aa]ssets/StreamingAssets/aa*
/YazLabUnity/[Aa]ssets/AddressableAssetsData/link.xml*
/YazLabUnity/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/YazLabUnity/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/YazLabUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/YazLabUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/YazLabUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/YazLabUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/YazLabUnity/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/YazLabUnity/UIElementsSchema/

# Auto-generated cache in Assets folder
/YazLabUnity/[Aa]ssets/[Ss]ceneDependencyCache*

# Proje kökü: ham asset paketleri ve yerel dosyalar (kullanılan sprite'lar Assets/_Project/Art altına kopyalanır)
/2ddungeonassetpackwithoutoutline/
/free-2d-top-down-pixel-dungeon-asset-pack/
/*.pdf
/install-skills.sh
.DS_Store
/YazLabUnity/.vscode/
/.claude/
/*.zip
/Teslim/
/ML/.venv/
/ML/results/
/YazLabUnity/Assets/ML-Agents/
/YazLabUnity/Assets/ML-Agents.meta
